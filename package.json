{
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --no-oxlint && bin/gen-vendor-types.sh",
    "start": "ags run src/app/app.ts",
    "icons": "bin/build-icons.sh",
    "watch": "bin/watch.sh",
    "typecheck": "tsc && tsc -p tsconfig.test.json",
    "build": "tsc && bin/build-icons.sh && mkdir -p dist && ags bundle src/app/app.ts dist/pyk --gtk 4",
    "typesafe-i18n": "typesafe-i18n",
    "test": "node --test --import tsx \"src/**/*.test.ts\""
  },
  "dependencies": {
    "ags": "link:/usr/share/ags/js",
    "clsx": "^2.1.1",
    "effect": "^4.0.0-rc.113",
    "gnim": "^1.9.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.43.0",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typesafe-i18n": "^5.27.1",
    "typescript": "7.0.2"
  }
}
