{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4",
    "lib": ["ES2023"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "paths": {
      "ags/*": ["/usr/share/astal/gjs/*"],
      "@/*": ["./src/*"]
    },
    "strict": true,
    "target": "ES2020",
    "plugins": [
      { "name": "@effect/language-service" }
    ]
  }
}
