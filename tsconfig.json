{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4",
    "lib": ["ES2023"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"],
      "ags": ["./types/vendor/lib/index.d.ts"],
      "ags/*": ["./types/vendor/lib/*"],
      "gnim": ["./types/vendor/node_modules/gnim/dist/index.d.ts"],
      "gnim/*": ["./types/vendor/node_modules/gnim/dist/*"]
    },
    "strict": true,
    "target": "ES2020",
    "noEmit": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "outdatedApi": "error",
          "preferSchemaOverJson": "warning"
        }
      }
    ]
  },
  "include": ["src", "env.d.ts", "@girs"]
}
